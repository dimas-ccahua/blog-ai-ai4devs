{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "GUARDIAN=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/regla.sh\"; if [ -f \"$GUARDIAN\" ]; then sh \"$GUARDIAN\"; fi",
            "statusMessage": "Comprobando la regla de las funciones nuevas",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
